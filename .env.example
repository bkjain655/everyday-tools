# Canonical site URL (custom domain). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://tools.bkjlabs.com

# Google Search Console verification token (HTML-tag method). Paste only the
# token from the meta tag. Leave blank if verifying via DNS or Google Analytics.
GOOGLE_SITE_VERIFICATION=

# GA4 measurement ID for this site's own property (Analytics → Admin → Data
# streams → Measurement ID). Overrides the built-in default; leave blank locally
# to disable analytics in development.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Contact form (Resend). All three are required for /api/contact to send.
# Verify the bkjlabs.com domain in Resend, then use its addresses below.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=contact@bkjlabs.com

# Verified Resend sender (on bkjlabs.com). This is the From; the visitor's address
# is only ever used as Reply-To, which is what prevents header injection.
CONTACT_FROM_EMAIL="Everyday Tools <noreply@bkjlabs.com>"
